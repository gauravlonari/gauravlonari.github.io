---
import '@fontsource-variable/bricolage-grotesque';
import { getCollection, render } from 'astro:content';
import { profile } from '../data/profile';
import { links } from '../data/links';
import { skillGroups } from '../data/skills';
import { projects } from '../data/projects';
import { log, kindLabel } from '../data/log';
const studies = Object.fromEntries(await Promise.all((await getCollection('caseStudies')).map(async e => [e.id, (await render(e)).Content])));
const description = `${profile.title} at ${profile.company}. A changelog of what shipped: performance, platform, reliability and the numbers behind each.`;
const primary = links.filter(l => ['Resume (PDF)','GitHub','LinkedIn'].includes(l.label));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{profile.name} — {profile.title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${profile.name} — ${profile.title}`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="profile" />
  <meta property="og:url" content="https://gauravlonari.github.io/" />
  <link rel="canonical" href="https://gauravlonari.github.io/" />
  <script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch{}</script>
</head>
<body>
  <a class="skip" href="#log">Skip to the log</a>
  <header class="top">
    <div>
      <p class="name">{profile.name}</p>
      <p class="role">{profile.title}, {profile.company}. {profile.location}, open to remote.</p>
    </div>
    <nav aria-label="Links"><ul>{primary.map(l => <li><a href={l.href}>{l.label}</a></li>)}<li><button type="button" id="theme">Theme: system</button></li></ul></nav>
  </header>

  <main>
    <section class="lede" aria-labelledby="lede-h">
      <h1 id="lede-h">I ship the enrolment system behind 1M+ people's health cover.<br />This is the log.</h1>
      <p>Four years, one team, reverse order. Each entry is a change that reached production, with the number it moved.</p>
    </section>

    <section id="log" aria-labelledby="log-h">
      <h2 id="log-h" class="vh">Shipping log</h2>
      <ol class="log">
        {log.map(e => (
          <li class={`entry kind-${e.kind}`}>
            <div class="rail"><time>{e.date}</time><span class="dot" aria-hidden="true"></span></div>
            <div class="body">
              <p class="kind">{kindLabel[e.kind]}</p>
              <h3>{e.title}</h3>
              {e.metric && (
                <dl class="metrics">
                  {e.metric.map(m => (<div><dt>{m.label}</dt><dd>{m.from && <span class="from">{m.from}</span>}{m.from && <span class="arrow" aria-label="to">→</span>}<span class="to">{m.to}</span></dd></div>))}
                </dl>
              )}
              {e.note && <p class="note">{e.note}</p>}
              {e.caseStudy && studies[e.caseStudy] && (
                <details><summary>How it was done</summary><div class="study">{(() => { const C = studies[e.caseStudy]; return <C />; })()}</div></details>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid2" aria-labelledby="sk-h">
      <div>
        <h2 id="sk-h">Skills</h2>
        <dl class="skills">{skillGroups.map(g => (<><dt>{g.name}</dt><dd>{g.items.join(', ')}</dd></>))}</dl>
      </div>
      <div>
        <h2>Outside work</h2>
        {projects.map(p => (<p><a href={p.url}><strong>{p.name}</strong></a> — {p.summary}</p>))}
        <h2 style="margin-top:2rem">Contact</h2>
        <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p class="social">{links.filter(l => l.label !== 'Resume (PDF)').map(l => <a href={l.href}>{l.label}</a>)}</p>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => { const b = document.getElementById('theme'); const order = ['system','dark','light'];
      const get = () => localStorage.getItem('theme') || 'system';
      const paint = () => { b.textContent = 'Theme: ' + get(); };
      b.addEventListener('click', () => { const n = order[(order.indexOf(get()) + 1) % 3];
        if (n === 'system') { localStorage.removeItem('theme'); document.documentElement.removeAttribute('data-theme'); }
        else { localStorage.setItem('theme', n); document.documentElement.setAttribute('data-theme', n); } paint(); });
      paint(); })();
  </script>
</body>
</html>

<style is:global>
  :root { --paper:#F7F8FA; --ink:#0F172A; --muted:#4B5567; --rule:#DDE1E8; --accent:#0E8A5F; --accent-ink:#0B6E4C; --chip:#EEF1F5; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --paper:#0F172A; --ink:#EEF2F7; --muted:#A5AFC0; --rule:#26314A; --accent:#3DDC97; --accent-ink:#7EE8B8; --chip:#1B2540; } }
  :root[data-theme="dark"] { --paper:#0F172A; --ink:#EEF2F7; --muted:#A5AFC0; --rule:#26314A; --accent:#3DDC97; --accent-ink:#7EE8B8; --chip:#1B2540; }
  * { box-sizing:border-box; margin:0; }
  html { color-scheme: light dark; }
  body { background:var(--paper); color:var(--ink); font-family:'Bricolage Grotesque Variable', system-ui, sans-serif; font-size:1.0625rem; line-height:1.5; font-variant-numeric:tabular-nums; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration-color:var(--accent); text-decoration-thickness:2px; text-underline-offset:.18em; }
  a:hover { color:var(--accent-ink); }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:2px; }
  .skip { position:absolute; left:-999px; top:8px; background:var(--chip); padding:.5rem .75rem; z-index:10; } .skip:focus { left:8px; }
  .vh { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  .top, main { width:min(100% - 2.5rem, 880px); margin-inline:auto; }
  .top { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding:1.5rem 0; border-bottom:1px solid var(--rule); flex-wrap:wrap; }
  .name { font-weight:700; } .role { color:var(--muted); font-size:.95rem; }
  .top nav ul { list-style:none; padding:0; display:flex; gap:1.25rem; flex-wrap:wrap; }
  .top button { background:none; border:0; font:inherit; color:inherit; cursor:pointer; text-decoration:underline; text-decoration-color:var(--accent); text-decoration-thickness:2px; text-underline-offset:.18em; padding:0; }
  .lede { padding:4rem 0 3rem; }
  h1 { font-weight:800; font-size:clamp(2.1rem, 5.2vw, 3.6rem); line-height:1.05; letter-spacing:-.02em; max-width:20ch; }
  .lede p { color:var(--muted); margin-top:1.25rem; max-width:52ch; font-size:1.125rem; }
  h2 { font-weight:700; font-size:1.35rem; margin-bottom:1rem; }
  /* the log */
  .log { list-style:none; padding:0; margin:0; }
  .entry { display:grid; grid-template-columns: 7.5rem 1fr; gap:0 2rem; }
  .rail { position:relative; padding-top:.35rem; text-align:right; color:var(--muted); font-size:.95rem; }
  .rail::after { content:''; position:absolute; top:0; bottom:0; right:-1rem; width:2px; background:var(--rule); }
  .entry:first-child .rail::after { top:.6rem; } .entry:last-child .rail::after { bottom:auto; height:.6rem; }
  .dot { position:absolute; z-index:1; right:calc(-1rem - 5px); top:.6rem; width:12px; height:12px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px var(--paper); }
  .body { padding-bottom:2.75rem; }
  .kind { font-size:.85rem; color:var(--accent-ink); font-weight:600; }
  h3 { font-weight:700; font-size:1.25rem; line-height:1.3; margin:.15rem 0 .6rem; max-width:34ch; }
  .metrics { display:flex; flex-wrap:wrap; gap:.75rem 2.25rem; margin:.25rem 0 .75rem; }
  .metrics div { display:grid; } .metrics dt { font-size:.85rem; color:var(--muted); order:2; } .metrics dd { order:1; }
  .from { color:var(--muted); font-weight:500; font-size:1.35rem; text-decoration:line-through; text-decoration-color:var(--rule); text-decoration-thickness:2px; }
  .arrow { color:var(--accent); margin:0 .35rem; font-size:1.35rem; } .to { font-weight:800; font-size:1.9rem; letter-spacing:-.01em; }
  .note { color:var(--muted); max-width:62ch; }
  details { margin-top:.75rem; max-width:62ch; } summary { cursor:pointer; font-weight:600; color:var(--accent-ink); }
  .study { margin-top:.5rem; padding-left:1rem; border-left:2px solid var(--rule); } .study h4 { font-size:.9rem; color:var(--muted); margin:.9rem 0 .2rem; } .study h4:first-child { margin-top:.5rem; } .study p { margin:0; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:3rem; padding:3rem 0 4rem; border-top:1px solid var(--rule); }
  .skills dt { font-weight:600; margin-top:.75rem; } .skills dd { color:var(--muted); font-size:.95rem; }
  .social { display:flex; gap:1.25rem; flex-wrap:wrap; }
  @media (max-width: 700px) {
    .entry { grid-template-columns:1fr; } .rail { text-align:left; padding-left:1.25rem; }
    .rail::after { left:.25rem; right:auto; } .dot { left:calc(.25rem - 5px); right:auto; }
    .body { padding-left:1.25rem; } .grid2 { grid-template-columns:1fr; }
    .to { font-size:1.6rem; } .from, .arrow { font-size:1.15rem; }
  }
</style>
